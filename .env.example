# ==========================================================
# 家庭安心管家 — 环境变量示例
# 复制为 .env 后填入真实值。切勿把任何真实密钥提交到仓库。
# ==========================================================

# ---------- 数据库（PostgreSQL）----------
# 本地开发示例：
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/jtaxgj?schema=public"
# Supabase / 云端带连接池时，另外提供直连地址给 migrate 使用：
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"
DIRECT_URL=""

# ---------- 会话签名密钥 ----------
# 生产环境必须替换为随机值：openssl rand -base64 48
AUTH_SECRET="dev-only-secret-please-change-me-in-production-0123456789"

# 会话有效期（秒），默认 8 小时
AUTH_SESSION_MAX_AGE="28800"

# ---------- 运行环境 ----------
# development | production
NODE_ENV="development"

# 站点地址（用于生成绝对链接、Signed URL 回调等）
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------- Demo 开关 ----------
# 为 "true" 时：登录页显示 Demo 帐号快捷入口、界面显示「示例数据」水印。
# 正式部署请设为 "false"。
NEXT_PUBLIC_DEMO_MODE="true"

# ---------- 内置自检 / E2E 端点 ----------
# 供 /api/dev/selfcheck 使用的令牌；留空则该端点完全关闭。
# 生产环境请留空。
DEV_CHECK_TOKEN=""

# ---------- 私有对象存储（预留，第一版未接）----------
# 上门照片、证书、合同等附件不得使用公开 URL，须走私有存储 + 临时签名地址。
STORAGE_DRIVER="local"
STORAGE_BUCKET=""
STORAGE_REGION=""
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
# 签名地址有效期（秒）
STORAGE_SIGNED_URL_TTL="300"

# ---------- 通知渠道（预留，第一版仅站内通知）----------
SMS_PROVIDER=""
SMS_ACCESS_KEY=""
WECHAT_APP_ID=""
WECHAT_APP_SECRET=""
WECOM_CORP_ID=""
WECOM_AGENT_ID=""
WECOM_SECRET=""

# ---------- AI 报告整理（预留，默认关闭）----------
# 开启后仅允许「基于原始记录重述」，禁止生成原始记录中不存在的内容，
# 且必须经人工确认才可发送家庭端。
AI_REPORT_ENABLED="false"
AI_API_KEY=""
AI_MODEL=""
